{
	"name": "docs",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"copy-docs": "bun ./scripts/copy-package-docs.ts",
		"generate-cli-docs": "bun ./scripts/generate-cli-docs.ts",
		"generate-llms-txt": "bun ./scripts/generate-llms-txt.ts",
		"prebuild": "bun run copy-docs && bun run generate-cli-docs && bun run generate-llms-txt",
		"dev": "bun run prebuild && astro dev",
		"start": "bun run prebuild && node ./dist/server/entry.mjs",
		"build": "bun run prebuild && astro build",
		"preview": "astro preview",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/node": "^11.0.3",
		"@astrojs/starlight": "^0.41.5",
		"@astrojs/vercel": "^11.0.4",
		"@types/node": "^26.1.2",
		"astro": "^7.1.5",
		"chalk": "^6.0.0",
		"glob": "^13.0.6",
		"sharp": "^0.35.3",
		"starlight-typedoc": "^0.23.0",
		"typedoc": "^0.28.20",
		"typedoc-plugin-markdown": "^4.12.0",
		"unreal-orm": "workspace:*"
	},
	"devDependencies": {
		"typescript": "^7.0.2"
	},
	"packageManager": "bun@1.3.2"
}
